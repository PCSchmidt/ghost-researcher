FROM mcr.microsoft.com/playwright/python:v1.44.0-jammy

ENV PYTHONUNBUFFERED=1 \
    PORT=9222

WORKDIR /app

# Ensure we have what we need. cloakbrowser supplies the patched stealth
# Chromium that actually defeats Cloudflare/Turnstile; playwright is kept for the
# CLOAKSERVE_STEALTH=0 vanilla baseline used in before/after measurement.
COPY requirements.txt .
RUN pip install -r requirements.txt playwright cloakbrowser
# Ensure playwright browsers are installed (vanilla baseline only)
RUN playwright install chromium
# Pre-download CloakBrowser's patched stealth Chromium at build time, not on the
# first request. Caches into /root/.cloakbrowser for the runtime process.
RUN python -c "from cloakbrowser import ensure_binary; ensure_binary()"

COPY backend/scripts/start_cloakserve.py ./backend/scripts/start_cloakserve.py

# A naive healthcheck for WebSocket
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT}/json/version || exit 1

EXPOSE ${PORT}

# Run the CDP server
CMD ["python", "backend/scripts/start_cloakserve.py"]
