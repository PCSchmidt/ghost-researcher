# Model gateway. OpenRouter is the default path; Anthropic is optional fallback only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=GhostResearcher
OPENROUTER_HTTP_REFERER=http://localhost:8000
DEFAULT_PLANNER_MODEL=deepseek/deepseek-v4-flash
FALLBACK_PLANNER_MODEL=deepseek/deepseek-v4-pro
DEFAULT_SYNTHESIZER_MODEL=deepseek/deepseek-v4-flash
FALLBACK_SYNTHESIZER_MODEL=moonshotai/kimi-k2.6

# Optional premium fallback, not default
ANTHROPIC_API_KEY=

# CloakBrowser CDP
CLOAK_CDP_URL=http://localhost:9222
# cloakserve launches CloakBrowser's patched stealth Chromium by default.
# Set to 0 to launch vanilla Chromium for the detection_blocked baseline
# (see evals/blocked_rate.py).
CLOAKSERVE_STEALTH=1
# Periodic browser recycling (set on the cloakserve service). The long-lived shared
# browser degrades over time and can start hanging CDP target sync. After this many
# seconds cloakserve terminates and relaunches Chromium on the same port (one browser
# at a time, brief window where a nav or two fail fast). 0 disables (default).
# Recommended in production: 21600 (6h).
CLOAKSERVE_MAX_AGE_SECONDS=0

# Data layer
DATABASE_URL=postgresql://user:pass@host:5432/dbname
REDIS_URL=redis://host:6379
# Durable reports. When set, jobs persist to this JSON file so shareable permalinks
# and the /reports list survive an API redeploy. In production point it at a mounted
# Railway volume (e.g. /data/reports.json); unset = in-memory (lost on restart).
REPORTS_DB_PATH=

# Search provider. deterministic requires no key; brave is opt-in for live evals.
SEARCH_PROVIDER=deterministic
SEARCH_API_KEY=
SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

# Proxy (for high bot-risk sources)
PROXY_URL=
PROXY_USER=
PROXY_PASS=

# Agent behavior
GHOSTRESEARCHER_RUN_LIVE_TESTS=0
MAX_STEPS_PER_JOB=20
# Shared token budget for the whole job (research loop + synthesis). Long-form
# synthesis is multi-pass, and the research loop can spend most of a tight budget
# first — so raise this when LONGFORM_ENABLED=true (~500000) or synthesis cost-limits
# and the run falls back to a deterministic (non-model) report.
MAX_TOKENS_PER_JOB=125000
# Per-job model spend cap. Long-form synthesis (LONGFORM_ENABLED=true) makes several
# model calls (outline + per-section drafting + framing), so raise this to ~0.75 when
# long-form is on, or synthesis can hit the cap mid-report. Keep WARN below it.
MAX_MODEL_COST_PER_JOB_USD=0.15
# Long-form research report (v1.5.0). When true, synthesis runs multi-pass and emits a
# research-paper structure (abstract, themed sections with in-text citations, conclusion,
# references) instead of a one-page brief. Cheap tier (DEFAULT_SYNTHESIZER_MODEL) drafts
# sections; premium tier (FALLBACK_SYNTHESIZER_MODEL) handles outline + framing. Length
# emerges from evidence (DEC-011). Raise MAX_MODEL_COST_PER_JOB_USD when enabling.
LONGFORM_ENABLED=false
LONGFORM_MAX_SECTIONS=6
# Wall-clock budget per research job. When spent, the planner stops and synthesis
# runs on collected evidence so the request returns a report instead of timing out.
# Since POST /research is now async (returns immediately, client polls), this no
# longer needs to stay under the deploy request timeout — it bounds in-loop planning.
JOB_TIME_BUDGET_SECONDS=240
# Hard wall-clock backstop on the WHOLE background job (research loop + synthesis). The
# in-loop budget only checks between steps, so a single hung browser/CDP call could run
# forever and, because jobs are serialized on the shared browser, stall the queue. On
# timeout the job is cancelled and stored as a terminal error. Keep it well above
# JOB_TIME_BUDGET_SECONDS — long-form synthesis (multi-pass) runs AFTER the research loop,
# so leave it headroom (with LONGFORM_ENABLED=true, ~420 is a good floor).
JOB_HARD_TIMEOUT_SECONDS=420
WARN_MODEL_COST_PER_JOB_USD=0.02
SCRAPE_ENABLED=true
LOG_LEVEL=INFO

# Frontend (set in Vercel environment, not here)
NEXT_PUBLIC_API_URL=https://your-railway-url.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app